<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Defuse | Neutralize the Trigger</title>
    <style>
        :root {
            --bg: #0f172a; /* Deep Charcoal */
            --card: #1e293b; 
            --teal: #2dd4bf; /* Tactical Teal */
            --red: #f43f5e; /* Alert Red */
            --gold: #fbbf24; /* Neutralizing Gold */
            --text: #f1f5f9;
        }

        body { 
            background: var(--bg); 
            color: var(--text); 
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; 
            margin: 0; 
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .screen { display: none; flex-direction: column; align-items: center; justify-content: center; padding: 20px; text-align: center; min-height: 85vh; }
        .active { display: flex; animation: slideUp 0.3s ease-out; }
        @keyframes slideUp { from { transform: translateY(10px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

        .btn { 
            background: var(--card); 
            border: 1px solid var(--teal); 
            color: var(--teal); 
            padding: 18px; 
            border-radius: 12px; 
            cursor: pointer; 
            margin: 10px; 
            width: 90%; 
            max-width: 320px;
            font-weight: 700;
            font-size: 1rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: 0.2s;
        }
        .btn-sos { background: var(--red); color: white; border: none; box-shadow: 0 4px 20px rgba(244, 63, 94, 0.4); }
        .btn-gold { border-color: var(--gold); color: var(--gold); }

        /* NEUTRALIZATION PULSE */
        .pulse-circle { 
            width: 140px; height: 140px; 
            background: var(--teal); 
            border-radius: 50%; 
            opacity: 0.2; 
            margin-bottom: 40px;
            animation: pulse 10s infinite ease-in-out; 
        }
        @keyframes pulse { 
            0%, 100% { transform: scale(0.9); opacity: 0.1; } 
            45%, 55% { transform: scale(1.5); opacity: 0.4; } 
        }

        nav { 
            position: fixed; bottom: 0; width: 100%; 
            background: #020617; display: flex; 
            justify-content: space-around; padding: 15px 0;
            border-top: 1px solid rgba(45, 212, 191, 0.2);
        }
        nav button { background: none; border: none; color: var(--text); cursor: pointer; opacity: 0.6; font-size: 0.75rem; font-weight: bold; }

        #onboarding {
            position: fixed; inset: 0; background: var(--bg); z-index: 1000;
            display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 40px;
        }

        textarea { background: var(--card); color: var(--text); border: 1px solid var(--teal); border-radius: 8px; padding: 15px; width: 90%; max-width: 320px; margin-bottom: 15px; font-size: 1rem; }
    </style>
</head>
<body>

    <div id="onboarding">
        <h1 style="color: var(--teal); letter-spacing: 4px; font-weight: 900;">DEFUSE</h1>
        <p style="opacity: 0.8; line-height: 1.6;">A tactical toolkit to neutralize emotional spikes and physical triggers in 60 seconds.</p>
        <div style="text-align: left; margin: 30px 0; border-left: 3px solid var(--teal); padding-left: 20px;">
            <p><strong>01. SOS:</strong> Rapid Pulse Neutralization.</p>
            <p><strong>02. RESET:</strong> Biological System Override.</p>
            <p><strong>03. LOGIC:</strong> Cognitive De-escalation.</p>
        </div>
        <button class="btn" onclick="initialize()">Initialize Protocol</button>
    </div>

    <div id="home" class="screen active">
        <h2 style="letter-spacing: 2px; font-weight: 300; color: var(--teal);">SYSTEM READY</h2>
        <p style="opacity: 0.5; margin-bottom: 40px;">Select a neutralization method.</p>
        <button class="btn btn-sos" onclick="show('sos')">SOS: DEFUSE NOW</button>
        <button class="btn" onclick="show('grounding')">Sensory Anchor (5-4-3-2-1)</button>
        <button class="btn" onclick="show('icedive')">Biological Reset ❄️</button>
        <button class="btn" onclick="show('cbt')">Logic Fact-Checker</button>
    </div>

    <div id="sos" class="screen">
        <div class="pulse-circle"></div>
        <h2 id="p-text" style="color: var(--teal); letter-spacing: 2px;">INHALING...</h2>
        <p style="opacity: 0.6;">Sync your central nervous system.</p>
        <button class="btn" onclick="show('home')">Pulse Stabilized</button>
    </div>

    <div id="grounding" class="screen">
        <h2 id="g-title">ANCHORING</h2>
        <p id="g-desc" style="font-size: 1.2rem; color: var(--teal); min-height: 60px;">Identify 5 objects you can SEE.</p>
        <h1 id="g-count" style="font-size: 4rem; margin: 10px; font-weight: 900;">5</h1>
        <button class="btn" onclick="nextAnchor()">Next Input</button>
    </div>

    <div id="icedive" class="screen">
        <h2 style="color: #2dd4bf;">DIVE REFLEX RESET</h2>
        <p style="padding: 0 20px; opacity: 0.8;">Apply ice to face or hands. Force heart rate reduction.</p>
        <h1 id="timer" style="font-size: 5rem; margin: 10px; color: var(--teal); font-weight: 900;">15</h1>
        <button class="btn" onclick="startResetTimer()" id="timer-btn">Begin 15s Override</button>
        <button class="btn" onclick="show('home')" style="border:none; opacity:0.4;">Abort</button>
    </div>

    <div id="cbt" class="screen">
        <h2>DEFUSE LOGIC</h2>
        <p style="opacity: 0.6;">Input the irrational trigger for analysis.</p>
        <textarea id="thought" placeholder="Ex: 'Everything is falling apart...'"></textarea>
        <button class="btn btn-gold" onclick="openVault()">Seal & Analyze 🔒</button>
        <button class="btn" onclick="show('home')" style="border:none;">Return</button>
    </div>

    <nav>
        <button onclick="show('home')">STATUS</button>
        <button onclick="show('sos')">DEFUSE</button>
        <button onclick="openVault()">VAULT 🔒</button>
    </nav>

    <script>
        function show(id) {
            document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
            document.getElementById(id).classList.add('active');
            if(id === 'sos') startPulseText();
        }

        function initialize() {
            document.getElementById('onboarding').style.display = 'none';
            localStorage.setItem('defuse_init', 'true');
        }

        let pulseInt;
        function startPulseText() {
            const txt = document.getElementById('p-text');
            if(pulseInt) clearInterval(pulseInt);
            pulseInt = setInterval(() => {
                let s = Math.floor(Date.now() / 1000) % 10;
                if (s < 4) txt.innerText = "INHALING...";
                else if (s < 6) txt.innerText = "HOLDING...";
                else txt.innerText = "EXHALING...";
            }, 1000);
        }

        let aStep = 5;
        const aPrompts = ["SEE", "TOUCH", "HEAR", "SMELL", "TASTE"];
        function nextAnchor() {
            aStep--;
            if(aStep < 1) { 
                alert("System Neutralized. You are present.");
                show('home'); 
                aStep = 5; 
            }
            document.getElementById('g-desc').innerText = "Identify " + aStep + " inputs you can " + aPrompts[5-aStep] + ".";
            document.getElementById('g-count').innerText = aStep;
        }

        function startResetTimer() {
            let t = 15;
            const el = document.getElementById('timer');
            const btn = document.getElementById('timer-btn');
            btn.disabled = true;
            const interval = setInterval(() => {
                t--; el.innerText = t;
                if(t <= 0) { 
                    clearInterval(interval); 
                    el.innerText = "RESET"; 
                    btn.disabled = false;
                    alert("Biological override successful. Pulse should be dropping."); 
                }
            }, 1000);
        }

        function openVault() {
            const email = prompt("DEFUSE PRO: Enter email to unlock the Resilience Vault and save trigger logs ($4.99/mo):");
            if(email) alert("Encrypted link sent to " + email + ".");
        }

        window.onload = () => {
            if(localStorage.getItem('defuse_init')) {
                document.getElementById('onboarding').style.display = 'none';
            }
        }
    </script>
</body>
</html>
